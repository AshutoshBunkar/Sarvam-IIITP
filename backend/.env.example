# Application
PROJECT_NAME="Bhasha Doubt Solver"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For local PostgreSQL with asyncpg:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/bhasha_db"
# Fallback / testing async SQLite database (used automatically if configured or testing):
# DATABASE_URL="sqlite+aiosqlite:///./bhasha.db"

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Sarvam AI Configuration
SARVAM_API_KEY=""
SARVAM_CHAT_MODEL="sarvam-105b"
SARVAM_MAX_TOKENS=2000
SARVAM_TEMPERATURE=0.3
SARVAM_API_BASE_URL="https://api.sarvam.ai/v1"

